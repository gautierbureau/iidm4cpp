IIDM_CODE(THREE_WT_LEG2_RTC_STEP,      23)
IIDM_CODE(THREE_WT_LEG3_RTC_STEP,      24)
IIDM_CODE(THREE_WT_LEG1_PTC_STEP,      25)
IIDM_CODE(THREE_WT_LEG2_PTC_STEP,      26)
IIDM_CODE(THREE_WT_LEG3_PTC_STEP,      27)
IIDM_CODE(SHUNT_SECTION,               28)
IIDM_CODE(INTERNAL_CONNECTION,         29)
IIDM_CODE(CURRENT_LIMITS,              30)
IIDM_CODE(TEMPORARY_LIMIT,             31)
IIDM_CODE(OLG_SIDE1,                   32) // all OperationalLimitsGroups for Branch side 1
IIDM_CODE(OLG_SIDE2,                   33) // all OperationalLimitsGroups for Branch side 2
IIDM_CODE(OLG_LEG1,                    34) // all OperationalLimitsGroups for ThreeWT leg 1
IIDM_CODE(OLG_LEG2,                    35) // all OperationalLimitsGroups for ThreeWT leg 2

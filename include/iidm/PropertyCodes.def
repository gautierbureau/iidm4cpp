// Property codes shared by the C++ library and the Java bridge: the single source of truth.
//
//   IIDM_CODE(NAME, value)   // comment
//
// - C++: include/iidm/PropertyCodes.h expands it into iidm::prop::NAME constants.
// - Java: Maven generates com.powsybl.iidmbridge.PropertyCodes from it (java/pom.xml).
//
// Keep one IIDM_CODE per line, with a literal value; comments use //.

// ── Object types ─────────────────────────────────────────────────────────────
// A type code stands for its type in every primitive: getChildren(parent, TYPE) lists the
// parent's objects of that type, findById(TYPE, id) looks one up, getBool(object, TYPE) tells
// whether the object is one (Java instanceof), invoke(parent, TYPE) starts a new one.
IIDM_CODE(SUBSTATION,                  1)
IIDM_CODE(VOLTAGE_LEVEL,               2)
IIDM_CODE(GENERATOR,                   3)
IIDM_CODE(LOAD,                        4)
IIDM_CODE(LINE,                        5)
IIDM_CODE(TWO_WINDINGS_TRANSFORMER,    6)
IIDM_CODE(THREE_WINDINGS_TRANSFORMER,  7)
IIDM_CODE(HVDC_LINE,                   8)
IIDM_CODE(BOUNDARY_LINE,               9)
IIDM_CODE(SHUNT_COMPENSATOR,           10)
IIDM_CODE(STATIC_VAR_COMPENSATOR,      11)
IIDM_CODE(VSC_CONVERTER_STATION,       12)
IIDM_CODE(LCC_CONVERTER_STATION,       13)
IIDM_CODE(TERMINAL,                    14)
IIDM_CODE(BUS,                         15)
IIDM_CODE(SWITCH,                      16)
IIDM_CODE(BUSBAR_SECTION,              17)
IIDM_CODE(BATTERY,                     18)
IIDM_CODE(REACTIVE_CURVE_POINT,        19)
IIDM_CODE(RATIO_TAP_CHANGER,           20)
IIDM_CODE(PHASE_TAP_CHANGER,           21)
IIDM_CODE(RATIO_TAP_CHANGER_STEP,      22)
IIDM_CODE(PHASE_TAP_CHANGER_STEP,      23)
IIDM_CODE(THREE_WINDINGS_TRANSFORMER_LEG, 24)
IIDM_CODE(REACTIVE_LIMITS,             25)
IIDM_CODE(MIN_MAX_REACTIVE_LIMITS,     26)
IIDM_CODE(REACTIVE_CAPABILITY_CURVE,   27)
IIDM_CODE(REACTIVE_CAPABILITY_SHAPE,   35)
IIDM_CODE(REACTIVE_CAPABILITY_SHAPE_PLANE, 36)
IIDM_CODE(SHUNT_SECTION,               28) // a section of a non-linear shunt compensator model
IIDM_CODE(INTERNAL_CONNECTION,         29)
IIDM_CODE(CURRENT_LIMITS,              30)
IIDM_CODE(TEMPORARY_LIMIT,             31)
IIDM_CODE(OPERATIONAL_LIMITS_GROUP,    34)
IIDM_CODE(ACTIVE_POWER_LIMITS,         49)
IIDM_CODE(APPARENT_POWER_LIMITS,       50)
IIDM_CODE(SHUNT_COMPENSATOR_LINEAR_MODEL, 53)
IIDM_CODE(SHUNT_COMPENSATOR_NON_LINEAR_MODEL, 54)
IIDM_CODE(BOUNDARY_LINE_GENERATION,    55) // the generation of a boundary line
IIDM_CODE(BOUNDARY,                    56) // the far end of a boundary line
IIDM_CODE(ZIP_LOAD_MODEL,              58)
IIDM_CODE(EXPONENTIAL_LOAD_MODEL,      59)
IIDM_CODE(NETWORK,                     60) // getRelated(identifiable, NETWORK): its network
// Abstract types (Java interfaces)
IIDM_CODE(IDENTIFIABLE,                43)
IIDM_CODE(CONNECTABLE,                 44)
IIDM_CODE(INJECTION,                   45)
IIDM_CODE(BRANCH,                      46)
IIDM_CODE(HVDC_CONVERTER_STATION,      47)
IIDM_CODE(LOADING_LIMITS,              48) // current, active power or apparent power limits
IIDM_CODE(FLOWS_LIMITS_HOLDER,         51) // what holds flows limits: a 3WT leg, a boundary line, a branch side
IIDM_CODE(SHUNT_COMPENSATOR_MODEL,     52) // linear or non-linear
IIDM_CODE(LOAD_MODEL,                  57) // ZIP or exponential

// ── Shared properties (applicable to many types) ────────────────────────────
IIDM_CODE(ID,                          100)
IIDM_CODE(NAME,                        101) // string: getNameOrId; optional string: getOptionalName; set: setName
IIDM_CODE(COUNTRY,                     102) // string: Substation country (Country enum name)
IIDM_CODE(FICTITIOUS,                  103) // bool: any Identifiable (and its adder)
IIDM_CODE(ENSURE_ID_UNICITY,           104) // bool, adders only: make the id unique if it is taken
IIDM_CODE(SUBSTATION_TSO,              105) // string

// ── Identifiable ─────────────────────────────────────────────────────────────
IIDM_CODE(IDENTIFIABLE_TYPE,           120) // int: IdentifiableType ordinal
IIDM_CODE(ALIASES,                     121) // string list (sorted)
IIDM_CODE(ALIAS_TYPE,                  122) // keyed by alias: its type (none if it has none, or no such alias);
                                            // set: addAlias(alias, type), "" = no type; set none: removeAlias
IIDM_CODE(UNIQUE_ALIAS_TYPE,           123) // keyed by alias, set only: addAlias(alias, type, ensureAliasUnicity = true)
IIDM_CODE(ALIAS_FROM_TYPE,             124) // keyed by alias type: the alias of that type
IIDM_CODE(CONTAINER_TYPE,              125) // int, read-only: ContainerType ordinal (network, substation, voltage level)
// The number of objects of a type in a container, a view...: evaluate(object, CHILD_COUNT,
// {type code}), the size of getChildren(object, type code)
IIDM_CODE(CHILD_COUNT,                 126)
// setString(identifiable, ID, id): setId

// ── Properties (identifiables and the other powsybl properties holders) ──────
IIDM_CODE(PROPERTY,                    130) // keyed by property name: its value (none when absent); set none: removeProperty
IIDM_CODE(PROPERTY_NAMES,              131) // string list (sorted)

// ── Lists ────────────────────────────────────────────────────────────────────
// Some lookups give a list (the switches at a node...): an object, whose elements are
// getChildren(list, ELEMENTS), or getIntList(list, ELEMENTS) for numbers.
IIDM_CODE(ELEMENTS,                    135)

// ── Connectable ──────────────────────────────────────────────────────────────
IIDM_CODE(EQUIVALENT,                  140) // bool: an equivalent, from a network reduction (also an adder field)

// ── HvdcConverterStation (VSC and LCC) ───────────────────────────────────────
IIDM_CODE(CONVERTER_STATION_HVDC_TYPE, 150) // int: HvdcType ordinal (VSC, LCC)
IIDM_CODE(CONVERTER_STATION_LOSS_FACTOR, 151) // double (a float in powsybl)

// ── Network ──────────────────────────────────────────────────────────────────
// Its bus-breaker view buses: getChildren(network, BUS), getRelatedByString(network, REL_BBV_BUS,
// id); its bus view buses: REL_BV_BUS the same way. getRelated(identifiable, REL_PARENT_NETWORK):
// the smallest network that holds it.
IIDM_CODE(NETWORK_CASE_DATE,           110) // string: ISO-8601 date-time (ZonedDateTime)
IIDM_CODE(NETWORK_FORECAST_DISTANCE,   111) // int: minutes
IIDM_CODE(NETWORK_SOURCE_FORMAT,       112) // string, read-only
IIDM_CODE(NETWORK_VALIDATION_LEVEL,    113) // int, read-only: ValidationLevel ordinal;
                                            // evaluate {throwsException}: runValidationChecks
IIDM_CODE(NETWORK_MIN_VALIDATION_LEVEL, 114) // int, set only: setMinimumAcceptableValidationLevel
IIDM_CODE(NETWORK_COUNTRIES,           115) // string list: the countries of its substations (Country names, sorted)
IIDM_CODE(SUBSTATION_GEOGRAPHICAL_TAGS, 116) // string list (sorted)
IIDM_CODE(ADD_GEOGRAPHICAL_TAG,        117) // string, set only, on a substation: addGeographicalTag

// ── Generator-specific ───────────────────────────────────────────────────────
IIDM_CODE(GEN_TARGET_P,                200)
IIDM_CODE(GEN_MIN_P,                   203)
IIDM_CODE(GEN_MAX_P,                   204)
IIDM_CODE(GEN_ENERGY_SOURCE,           206)
IIDM_CODE(GEN_RATED_S,                 210)
IIDM_CODE(GEN_CONDENSER,               211) // bool

// ── Load-specific ────────────────────────────────────────────────────────────
// Its model: getRelated(load, LOAD_MODEL) (INVALID_HANDLE when it has none); invoke(load adder,
// ZIP_LOAD_MODEL / EXPONENTIAL_LOAD_MODEL) starts it (nested adder).
IIDM_CODE(LOAD_P0,                     300)
IIDM_CODE(LOAD_Q0,                     301)
IIDM_CODE(LOAD_TYPE,                   302) // int: LoadType ordinal
IIDM_CODE(LOAD_MODEL_TYPE,             303) // int, read-only, on a load model: LoadModelType ordinal
IIDM_CODE(ZIP_C0P,                     310) // double, ZIP load model: constant power part of P
IIDM_CODE(ZIP_C1P,                     311) // double: constant current part of P
IIDM_CODE(ZIP_C2P,                     312) // double: constant impedance part of P
IIDM_CODE(ZIP_C0Q,                     313) // double
IIDM_CODE(ZIP_C1Q,                     314) // double
IIDM_CODE(ZIP_C2Q,                     315) // double
IIDM_CODE(EXP_NP,                      316) // double, exponential load model: P exponent
IIDM_CODE(EXP_NQ,                      317) // double: Q exponent

// ── Terminal ─────────────────────────────────────────────────────────────────
// Its buses: getRelated(terminal, REL_BUS / REL_CONNECTABLE_BUS) in the bus-breaker view,
// getRelated(terminal, REL_BV_BUS / REL_BV_CONNECTABLE_BUS) in the bus view (none when it has none).
IIDM_CODE(TERMINAL_P,                  400)
IIDM_CODE(TERMINAL_Q,                  401)
IIDM_CODE(TERMINAL_CONNECTED,          402) // bool, read-only: connect with invoke(terminal, ACT_CONNECT)
IIDM_CODE(TERMINAL_NODE,               404) // node number (node-breaker topology)
IIDM_CODE(TERMINAL_BUS_BREAKER_BUS_ID, 406) // string: bus-breaker view bus ("" when disconnected); adders: setBus
IIDM_CODE(TERMINAL_BUS_BREAKER_CONNECTABLE_BUS_ID, 407) // string: bus-breaker view connectable bus ("" when none);
                                            // set: setConnectableBus; adders: setConnectableBus
IIDM_CODE(TERMINAL_SIDE,               408) // int: ThreeSides ordinal, -1 for an injection's terminal
IIDM_CODE(TERMINAL_I,                  409) // double, read-only: current (A)
// invoke(terminal, MOVE_CONNECTABLE) starts moving its end of the equipment: to a bus (fields
// TERMINAL_BUS_BREAKER_CONNECTABLE_BUS_ID and TERMINAL_CONNECTED: BusBreakerView.moveConnectable)
// or to a node (TERMINAL_NODE and TERMINAL_VOLTAGE_LEVEL_ID: NodeBreakerView.moveConnectable);
// invoke(change, ACT_ADD) moves it.
IIDM_CODE(MOVE_CONNECTABLE,            410)
IIDM_CODE(TERMINAL_VOLTAGE_LEVEL_ID,   411) // string, a field of MOVE_CONNECTABLE: the voltage level

// ── Bus ──────────────────────────────────────────────────────────────────────
// Its connected terminals: getChildren(bus, TERMINAL); its equipment: getChildren(bus, LINE /
// GENERATOR / LOAD...). invoke(bus, ACT_UNSET_SOLVED_VALUES) unsets its voltage and angle.
IIDM_CODE(BUS_V,                       500)
IIDM_CODE(BUS_ANGLE,                   501)
IIDM_CODE(BUS_P,                       502) // double, read-only: active power of its equipment (load sign convention)
IIDM_CODE(BUS_Q,                       503) // double, read-only
// Its fictitious injection, load sign convention (a node's: see VoltageLevel)
IIDM_CODE(FICTITIOUS_P0,               504) // double
IIDM_CODE(FICTITIOUS_Q0,               505) // double
IIDM_CODE(BUS_IN_MAIN_CONNECTED_COMPONENT, 506) // bool, read-only
IIDM_CODE(BUS_IN_MAIN_SYNCHRONOUS_COMPONENT, 507) // bool, read-only

// ── VoltageLevel ─────────────────────────────────────────────────────────────
// Its bus view buses: getChildren(vl, REL_BV_BUS), getRelatedByString(vl, REL_BV_BUS, id);
// getRelatedByString(vl, REL_MERGED_BUS, busbar section id): getMergedBus;
// getRelatedByString(vl, CONNECTABLE, id): getConnectable(id).
// Its node-breaker view: getRelatedByString(vl, BUSBAR_SECTION, id) a busbar section;
// getRelatedByIndex(vl, REL_NBV_TERMINAL_AT_NODE, node) the terminal at a node (none without one);
// getRelatedByIndex(vl, REL_NBV_SWITCH, node) the list of the switches at a node, and
// getRelatedByIndex(vl, INTERNAL_CONNECTION, node) the list of the nodes internally connected to
// it (see ELEMENTS). The fictitious injection at a node: evaluate(vl, FICTITIOUS_P0 / FICTITIOUS_Q0,
// {node}); invoke(vl, FICTITIOUS_P0 / FICTITIOUS_Q0) starts changing it (fields TERMINAL_NODE and
// FICTITIOUS_P0 / FICTITIOUS_Q0, then ACT_ADD).
// Its bus-breaker view: getRelatedByString(vl, REL_BBV_BUSES_OF_BV_BUS, bus view bus id) the list of
// the bus-breaker view buses in a bus view bus (sorted by id).
IIDM_CODE(VL_NOMINAL_V,                600)
IIDM_CODE(VL_LOW_VOLTAGE_LIMIT,        601)
IIDM_CODE(VL_HIGH_VOLTAGE_LIMIT,       602)
IIDM_CODE(VL_TOPOLOGY_KIND,            603) // int: TopologyKind ordinal; set: convertToTopology
IIDM_CODE(VL_TOPOLOGY_TEXT,            605) // string, read-only: printTopology
IIDM_CODE(VL_NBV_NODES,               604) // int list: node numbers in NodeBreakerView
IIDM_CODE(VL_NBV_MAXIMUM_NODE_INDEX,   606) // int, read-only
IIDM_CODE(VL_NBV_ATTACHED_EQUIPMENT,   607) // evaluate(vl, it, {node}): hasAttachedEquipment, 1 when an equipment,
                                            // a switch or an internal connection is at the node, else 0
IIDM_CODE(VL_NBV_REMOVE_SWITCH,        608) // string, set only: getNodeBreakerView().removeSwitch(id)
IIDM_CODE(VL_BBV_REMOVE_SWITCH,        609) // string, set only: getBusBreakerView().removeSwitch(id)
// invoke(vl, it) starts removeInternalConnections(node1, node2): fields IC_NODE1 and IC_NODE2, then ACT_ADD
IIDM_CODE(VL_NBV_REMOVE_INTERNAL_CONNECTIONS, 610)

// ── Line ─────────────────────────────────────────────────────────────────────
IIDM_CODE(LINE_R,                      700)
IIDM_CODE(LINE_X,                      701)
IIDM_CODE(LINE_G1,                     702)
IIDM_CODE(LINE_B1,                     703)
IIDM_CODE(LINE_G2,                     704)
IIDM_CODE(LINE_B2,                     705)

// ── TwoWindingsTransformer ───────────────────────────────────────────────────
// Its tap changers: getRelated(transformer, RATIO_TAP_CHANGER / PHASE_TAP_CHANGER); its substation
// (none when it has none): getRelated(transformer, REL_SUBSTATION).
IIDM_CODE(TWO_WT_R,                    800)
IIDM_CODE(TWO_WT_X,                    801)
IIDM_CODE(TWO_WT_G,                    802)
IIDM_CODE(TWO_WT_B,                    803)
IIDM_CODE(TWO_WT_RATED_U1,             804)
IIDM_CODE(TWO_WT_RATED_U2,             805)
IIDM_CODE(TWO_WT_RATED_S,              806)

// ── ThreeWindingsTransformer and its legs ────────────────────────────────────
// THREE_WINDINGS_TRANSFORMER_LEG is the legs' type code: getChildren(transformer, <it>) gives the
// three legs, getRelatedByIndex(transformer, <it>, side) one of them (ThreeSides ordinal), and
// getRelatedByIndex(transformer, REL_TERMINAL, side) the terminal of a side. On a leg,
// getRelated(leg, REL_TERMINAL) is its terminal, getRelated(leg, THREE_WINDINGS_TRANSFORMER) its
// transformer, getRelated(leg, RATIO_TAP_CHANGER / PHASE_TAP_CHANGER) its tap changers; a leg is a
// flows limits holder (see Limits).
IIDM_CODE(LEG_R,                       820) // double
IIDM_CODE(LEG_X,                       821) // double
IIDM_CODE(LEG_G,                       822) // double
IIDM_CODE(LEG_B,                       823) // double
IIDM_CODE(LEG_RATED_U,                 824) // double
IIDM_CODE(LEG_RATED_S,                 825) // double, NaN = undefined (optional double)
IIDM_CODE(LEG_SIDE,                    826) // int, read-only: ThreeSides ordinal
IIDM_CODE(THREE_WT_RATED_U0,           880) // double: ratedU0 (star-point voltage, kV)

// ── Tap changers (RatioTapChanger and PhaseTapChanger) ───────────────────────
// RATIO_TAP_CHANGER / PHASE_TAP_CHANGER are their type codes: getRelated(holder, RATIO_TAP_CHANGER)
// gives the ratio tap changer of a two windings transformer or of a three windings transformer leg
// (INVALID_HANDLE when it has none). invoke(tap changer, ACT_REMOVE) removes it.
// Their steps: getChildren(tap changer, RATIO_TAP_CHANGER_STEP / PHASE_TAP_CHANGER_STEP), from the
// low to the high tap position; getRelatedByIndex(tap changer, <step type>, tap position): one of
// them. A ratio tap changer regulates as every regulation holder (VoltageRegulation, REGULATING...);
// a phase tap changer with the PTC_* codes, REGULATING and REL_REGULATION_TERMINAL.
IIDM_CODE(TC_LOW_TAP_POSITION,         1900) // int
IIDM_CODE(TC_HIGH_TAP_POSITION,        1901) // int, read-only
IIDM_CODE(TC_TAP_POSITION,             1902) // int (optional: none when unset); unset: ACT_UNSET_TAP_POSITION
IIDM_CODE(TC_SOLVED_TAP_POSITION,      1903) // int (optional: none when unset); unset: ACT_UNSET_SOLVED_TAP_POSITION
IIDM_CODE(TC_STEP_COUNT,               1904) // int, read-only
IIDM_CODE(TC_NEUTRAL_POSITION,         1905) // optional int, read-only: position of the neutral step (rho 1, alpha 0)
IIDM_CODE(TC_LOAD_TAP_CHANGING_CAPABILITIES, 1906) // bool
// invoke(tap changer, TC_STEPS_REPLACER) starts the replacement of every step: invoke(replacer,
// RATIO_TAP_CHANGER_STEP / PHASE_TAP_CHANGER_STEP) starts each new step (STEP_* fields, ACT_ADD:
// endStep), invoke(replacer, ACT_ADD) replaces the steps (replaceSteps)
IIDM_CODE(TC_STEPS_REPLACER,           1907)
IIDM_CODE(PTC_REGULATION_MODE,         1910) // int: PhaseTapChangerRegulationMode ordinal
IIDM_CODE(PTC_REGULATION_VALUE,        1911) // double
IIDM_CODE(PTC_TARGET_DEADBAND,         1912) // double, NaN = undefined
// Steps of both kinds
IIDM_CODE(STEP_RHO,                    1920) // double
IIDM_CODE(STEP_R,                      1921) // double
IIDM_CODE(STEP_X,                      1922) // double
IIDM_CODE(STEP_G,                      1923) // double
IIDM_CODE(STEP_B,                      1924) // double
IIDM_CODE(PTC_STEP_ALPHA,              1925) // double: phase tap changer steps only

// ── HvdcLine ─────────────────────────────────────────────────────────────────
// Its converter stations: getRelated(line, REL_CONVERTER_STATION1 / 2), getRelatedByIndex(line,
// HVDC_CONVERTER_STATION, side); invoke(line, ACT_CONNECT / ACT_DISCONNECT) connects / disconnects
// them (connectConverterStations).
IIDM_CODE(HVDC_R,                      900)
IIDM_CODE(HVDC_NOMINAL_V,             901)
IIDM_CODE(HVDC_ACTIVE_POWER_SETPOINT, 902)
IIDM_CODE(HVDC_MAX_P,                  903)
IIDM_CODE(HVDC_CONVERTERS_MODE,        904)

// ── BoundaryLine (powsybl 7.4; DanglingLine before) ──────────────────────────
// A line to the outside of the network. getRelated(line, BOUNDARY_LINE_GENERATION) is its
// generation (INVALID_HANDLE when it has none), on which the GENERATION_* codes and the reactive
// limits apply; getRelated(line, BOUNDARY) is its boundary, the far end, with the BOUNDARY_* values
// (getRelated(boundary, BOUNDARY_LINE): its line, REL_VOLTAGE_LEVEL: the network side voltage
// level). A boundary line is a flows limits holder (see Limits).
IIDM_CODE(BL_P0,                       1000)
IIDM_CODE(BL_Q0,                       1001)
IIDM_CODE(BL_R,                        1002)
IIDM_CODE(BL_X,                        1003)
IIDM_CODE(BL_G,                        1004)
IIDM_CODE(BL_B,                        1005)
IIDM_CODE(BL_PAIRED,                   1006) // bool, read-only: in a tie line
IIDM_CODE(BL_PAIRING_KEY,              1007) // string (none when it has none)
IIDM_CODE(GENERATION_TARGET_P,         1010) // double
IIDM_CODE(GENERATION_MIN_P,            1011) // double
IIDM_CODE(GENERATION_MAX_P,            1012) // double
IIDM_CODE(GENERATION_TARGET_Q,         1013) // double
IIDM_CODE(GENERATION_TARGET_V,         1014) // double
IIDM_CODE(GENERATION_VOLTAGE_REGULATION_ON, 1015) // bool
IIDM_CODE(BOUNDARY_V,                  1020) // double, read-only
IIDM_CODE(BOUNDARY_ANGLE,              1021) // double, read-only
IIDM_CODE(BOUNDARY_P,                  1022) // double, read-only
IIDM_CODE(BOUNDARY_Q,                  1023) // double, read-only
IIDM_CODE(BOUNDARY_I,                  1024) // double, read-only

// ── ShuntCompensator ─────────────────────────────────────────────────────────
// Its model is getRelated(shunt, SHUNT_COMPENSATOR_MODEL); getRelated(shunt, SHUNT_COMPENSATOR_LINEAR_MODEL
// or SHUNT_COMPENSATOR_NON_LINEAR_MODEL) gives it as a model of that type (getModel(Class):
// ValidationException when it is of the other one). The sections of a non-linear model are
// getChildren(model, SHUNT_SECTION), from the first one.
IIDM_CODE(SHUNT_SECTION_COUNT,         1100) // int (optional: none when undefined); unset: ACT_UNSET_SECTION_COUNT
IIDM_CODE(SHUNT_MAX_SECTION_COUNT,     1101) // int: of the shunt; set: on its linear model (setMaximumSectionCount)
IIDM_CODE(SHUNT_B_PER_SECTION,         1102) // linear model
IIDM_CODE(SHUNT_G_PER_SECTION,         1103) // linear model
IIDM_CODE(SHUNT_MODEL_TYPE,            1104) // int, read-only: ShuntCompensatorModelType ordinal (0=LINEAR 1=NON_LINEAR)
IIDM_CODE(SHUNT_SECTION_B,             1105) // section of a non-linear model
IIDM_CODE(SHUNT_SECTION_G,             1106) // section of a non-linear model
IIDM_CODE(SHUNT_B,                     1110) // B at the section count; evaluate {sectionCount}: getB(sectionCount)
IIDM_CODE(SHUNT_SOLVED_SECTION_COUNT,  1111) // int (optional: none when unset); unset: ACT_UNSET_SOLVED_SECTION_COUNT
IIDM_CODE(SHUNT_G,                     1112) // G at the section count; evaluate {sectionCount}: getG(sectionCount)

// ── StaticVarCompensator ─────────────────────────────────────────────────────
IIDM_CODE(SVC_B_MIN,                   1200)
IIDM_CODE(SVC_B_MAX,                   1201)

// ── LccConverterStation ──────────────────────────────────────────────────────
IIDM_CODE(LCC_POWER_FACTOR,            1401)

// ── BusbarSection ────────────────────────────────────────────────────────────
IIDM_CODE(BBS_V,                       1600)
IIDM_CODE(BBS_ANGLE,                   1601)
IIDM_CODE(IC_NODE1,                    1610)
IIDM_CODE(IC_NODE2,                    1611)

// ── Battery ───────────────────────────────────────────────────────────────────
IIDM_CODE(BAT_TARGET_P,                1700)
IIDM_CODE(BAT_MIN_P,                   1702)
IIDM_CODE(BAT_MAX_P,                   1703)

// ── Reactive limits (of generators, batteries, VSC converter stations) ────────
// REACTIVE_LIMITS is their type code: getRelated(holder, REACTIVE_LIMITS) gives the reactive limits
// of a generator, battery or VSC converter station; getRelated(holder, MIN_MAX_REACTIVE_LIMITS /
// REACTIVE_CAPABILITY_CURVE / REACTIVE_CAPABILITY_SHAPE) the same, when they are of that kind
// (ValidationException otherwise). The points of a curve: getChildren(curve, REACTIVE_CURVE_POINT),
// by increasing p; the planes of a shape: getChildren(shape, REACTIVE_CAPABILITY_SHAPE_PLANE).
IIDM_CODE(RL_KIND,                     1810) // int: ReactiveLimitsKind ordinal
IIDM_CODE(RL_MIN_Q,                    1811) // double: MinMaxReactiveLimits.getMinQ(); evaluate {p}: getMinQ(p) of
                                             // any kind, {p, extrapolateReactiveLimitSlope} of a curve, {p, v} of a shape
IIDM_CODE(RL_MAX_Q,                    1812) // double: the same for getMaxQ
IIDM_CODE(CURVE_MIN_P,                 1813) // double
IIDM_CODE(CURVE_MAX_P,                 1814) // double
IIDM_CODE(CURVE_POINT_COUNT,           1815) // int
IIDM_CODE(SHAPE_IS_INSIDE,             1816) // evaluate {p, q, v}: 1 when the point is inside the shape, else 0
IIDM_CODE(POINT_P,                     1800) // double, on a curve point
IIDM_CODE(POINT_MIN_Q,                 1801) // double, on a curve point
IIDM_CODE(POINT_MAX_Q,                 1802) // double, on a curve point
IIDM_CODE(PLANE_ALPHA,                 1820) // double, on a shape plane
IIDM_CODE(PLANE_BETA,                  1821) // double
IIDM_CODE(PLANE_GAMMA,                 1822) // double
IIDM_CODE(PLANE_DELTA,                 1823) // double
IIDM_CODE(PLANE_LESS_OR_EQUAL,         1824) // bool
IIDM_CODE(PLANE_GREATER_OR_EQUAL,      1825) // bool


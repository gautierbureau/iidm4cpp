// ── Extension observability quality blocks: qualityBase + offset below ───────
IIDM_CODE(OBS_QUALITY_EXISTS_OFF,         0) // bool: quality defined
IIDM_CODE(OBS_QUALITY_STD_DEV_OFF,        1) // double: standard deviation (setting it creates the quality)
IIDM_CODE(OBS_QUALITY_REDUNDANT_OFF,      2) // int: -1 = undefined, 0 = false, 1 = true

// ── Extension: InjectionObservability (on any Injection) ─────────────────────
IIDM_CODE(EXT_INJ_OBS_EXISTS,             3900) // bool
IIDM_CODE(EXT_INJ_OBS_OBSERVABLE,         3901) // bool
IIDM_CODE(EXT_INJ_OBS_QUALITY_P,          3910) // quality block base
IIDM_CODE(EXT_INJ_OBS_QUALITY_Q,          3920) // quality block base
IIDM_CODE(EXT_INJ_OBS_QUALITY_V,          3930) // quality block base

// ── Extension: BranchObservability (on Line / TwoWT) ─────────────────────────
IIDM_CODE(EXT_BRANCH_OBS_EXISTS,          4000) // bool
IIDM_CODE(EXT_BRANCH_OBS_OBSERVABLE,      4001) // bool
IIDM_CODE(EXT_BRANCH_OBS_QUALITY_P1,      4010) // quality block base
IIDM_CODE(EXT_BRANCH_OBS_QUALITY_P2,      4020) // quality block base
IIDM_CODE(EXT_BRANCH_OBS_QUALITY_Q1,      4030) // quality block base
IIDM_CODE(EXT_BRANCH_OBS_QUALITY_Q2,      4040) // quality block base

// ── Extension: Measurements (on any Connectable) and Measurement handles ─────
IIDM_CODE(EXT_MEAS_EXISTS,                4100) // bool, on the host
IIDM_CODE(MEAS_ID,                        4101) // string
IIDM_CODE(MEAS_TYPE,                      4102) // int: MeasurementType ordinal
IIDM_CODE(MEAS_VALUE,                     4103) // double
IIDM_CODE(MEAS_STD_DEV,                   4104) // double
IIDM_CODE(MEAS_VALID,                     4105) // bool
IIDM_CODE(MEAS_SIDE,                      4106) // int: -1 = none, 0 = ONE, 1 = TWO, 2 = THREE

// ── Extension: DiscreteMeasurements (on any Identifiable) and DiscreteMeasurement handles ───
IIDM_CODE(EXT_DMEAS_EXISTS,               4200) // bool, on the host
IIDM_CODE(DMEAS_ID,                       4201) // string
IIDM_CODE(DMEAS_TYPE,                     4202) // int: DiscreteMeasurementType ordinal
IIDM_CODE(DMEAS_TAP_CHANGER,              4203) // int: DiscreteMeasurementTapChanger ordinal, -1 = none
IIDM_CODE(DMEAS_VALUE_TYPE,               4204) // int: DiscreteMeasurementValueType ordinal
IIDM_CODE(DMEAS_VALUE_STRING,             4205) // string
IIDM_CODE(DMEAS_VALUE_INT,                4206) // int
IIDM_CODE(DMEAS_VALUE_BOOL,               4207) // bool
IIDM_CODE(DMEAS_VALID,                    4208) // bool

// ── Extension: ObservabilityArea (on VoltageLevel) and area handles ──────────
IIDM_CODE(EXT_OBS_AREA_EXISTS,            4300) // bool, on the VoltageLevel
IIDM_CODE(EXT_OBS_AREA_CONSISTENT,        4301) // bool: isConsistentWithTopology, on the VoltageLevel
IIDM_CODE(OBS_AREA_NUMBER,                4302) // int
IIDM_CODE(OBS_AREA_STATUS,                4303) // int: ObservabilityStatus ordinal
IIDM_CODE(OBS_AREA_NODES,                 4304) // int list: node-breaker nodes (empty in bus-breaker topology)

// ── Child types: state estimation extensions ─────────────────────────────────
IIDM_CODE(MEASUREMENT,                    38) // Measurement handles of a Connectable
IIDM_CODE(DISCRETE_MEASUREMENT,           39) // DiscreteMeasurement handles of an Identifiable
IIDM_CODE(OBSERVABILITY_AREA,             40) // observability areas of a VoltageLevel
IIDM_CODE(OBS_AREA_TERMINALS,             41) // Terminal handles of an observability area
IIDM_CODE(OBS_AREA_BUSES,                 42) // bus-breaker view Bus handles of an observability area

// ── Relations: state estimation extensions ───────────────────────────────────
IIDM_CODE(REL_MEASUREMENT_BY_ID,          2025) // host (keyed by measurement id) → Measurement (getRelatedByString)
IIDM_CODE(REL_DISCRETE_MEASUREMENT_BY_ID, 2026) // host (keyed by id) → DiscreteMeasurement (getRelatedByString)
IIDM_CODE(REL_OBS_AREA_BY_NODE,           2027) // VL (indexed by node) → observability area (getRelatedByIndex)
IIDM_CODE(REL_OBS_AREA_BY_BUS,            2028) // VL (keyed by bus view bus id) → observability area (getRelatedByString)
IIDM_CODE(REL_OBS_AREA_BY_BBV_BUS,        2029) // VL (keyed by bus-breaker bus id) → observability area (getRelatedByString)

IIDM_CODE(REGULATING_TARGET_Q,         2214) // double, read-only: same for Q
IIDM_CODE(REGULATING_MODES,            2215) // int list: the modes m for which isRegulatingWithMode(m)
IIDM_CODE(WITH_MODES,                  2216) // int list: the modes m for which isWithMode(m)
IIDM_CODE(HAS_REGULATING_TERMINAL,     2217) // bool: the regulation has a terminal
// Holders: Generator, Battery, StaticVarCompensator, ShuntCompensator, VscConverterStation,
// RatioTapChanger; the regulating terminal is REL_REGULATING_TERMINAL; actions ACT_SET_TARGET_Q_TO_Q,
// ACT_SET_TARGET_V_TO_V

// ── Actions (invoke) ─────────────────────────────────────────────────────────
// invoke(parent, <type code>) starts a new object: it returns an adder, on which the setters
// take the object's own property codes (setDouble(adder, GEN_TARGET_P, 100)); nothing changes
// in the network until invoke(adder, ACT_ADD).
IIDM_CODE(ACT_ADD,                     5000) // invoke(adder): adds the object, returns it (INVALID_HANDLE for nested adders)
IIDM_CODE(ACT_REMOVE,                  5001) // invoke(identifiable): removes it from the network; invoke(tap changer): removes it
// invoke(terminal or connectable, ACT_CONNECT / ACT_DISCONNECT): connects / disconnects it (every
// terminal of a connectable, the converter stations of an HVDC line); returns the object when this
// changed it, INVALID_HANDLE when it could not, or already was.
IIDM_CODE(ACT_CONNECT,                 5002)
IIDM_CODE(ACT_DISCONNECT,              5003)
IIDM_CODE(ACT_SET_TARGET_Q_TO_Q,       5004) // invoke(regulation holder): targets Q from the solved Q;
                                             // invoke(boundary line): its generation's; invoke(load): Q0
IIDM_CODE(ACT_SET_TARGET_V_TO_V,       5005) // invoke(regulation holder): targets V from the solved V;
                                             // invoke(boundary line): its generation's
IIDM_CODE(ACT_UNSET_TAP_POSITION,      5006) // invoke(tap changer)
IIDM_CODE(ACT_UNSET_SOLVED_TAP_POSITION, 5007) // invoke(tap changer)
IIDM_CODE(ACT_APPLY_SOLVED_VALUES,     5008) // invoke(tap changer, transformer, generator, battery, load, shunt
                                             // compensator, boundary line): its solved values become its values
IIDM_CODE(ACT_SET_TAP_POSITION_TO_SOLVED_TAP_POSITION, 5009) // invoke(tap changer)
IIDM_CODE(ACT_CLEAN_IF_EMPTY,          5010) // invoke(extension): removes it when empty (Measurements,
                                             // DiscreteMeasurements, SlackTerminal)
IIDM_CODE(ACT_UNSET_SECTION_COUNT,     5011) // invoke(shunt compensator)
IIDM_CODE(ACT_UNSET_SOLVED_SECTION_COUNT, 5012) // invoke(shunt compensator)
IIDM_CODE(ACT_SET_SECTION_COUNT_TO_SOLVED_SECTION_COUNT, 5013) // invoke(shunt compensator)
IIDM_CODE(ACT_UNSET_SOLVED_VALUES,     5014) // invoke(connectable, terminal, bus): unsets its solved values (flows,
                                             // voltages; a shunt's solved section count, a transformer's tap positions)
IIDM_CODE(ACT_SET_RATIO_TAP_POSITION_TO_SOLVED_TAP_POSITION, 5015) // invoke(2WT or 3WT): of its ratio tap changers
IIDM_CODE(ACT_SET_PHASE_TAP_POSITION_TO_SOLVED_TAP_POSITION, 5016) // invoke(2WT or 3WT): of its phase tap changers
IIDM_CODE(ACT_SET_TARGET_P_TO_P,       5017) // invoke(generator, battery): targets P from the solved P;
                                             // invoke(boundary line): its generation's; invoke(load): P0
IIDM_CODE(ACT_REMOVE_ALL_BUSES,        5018) // invoke(voltage level): those of its bus-breaker view
IIDM_CODE(ACT_REMOVE_ALL_SWITCHES,     5019) // invoke(voltage level): those of its bus-breaker view


IIDM_CODE(GENERATION_MAX_P,            1012) // double
IIDM_CODE(GENERATION_TARGET_Q,         1013) // double
IIDM_CODE(GENERATION_TARGET_V,         1014) // double
IIDM_CODE(GENERATION_VOLTAGE_REGULATION_ON, 1015) // bool
IIDM_CODE(BOUNDARY_V,                  1020) // double, read-only
IIDM_CODE(BOUNDARY_ANGLE,              1021) // double, read-only
IIDM_CODE(BOUNDARY_P,                  1022) // double, read-only
IIDM_CODE(BOUNDARY_Q,                  1023) // double, read-only
IIDM_CODE(BOUNDARY_I,                  1024) // double, read-only

// ── TieLine ──────────────────────────────────────────────────────────────────
// Two boundary lines paired: a branch. getRelatedByIndex(tie line, BOUNDARY_LINE, side) (TwoSides
// ordinal) is one of them, getRelatedByString(tie line, BOUNDARY_LINE, voltage level id) the one in
// that voltage level (none when neither is); getRelated(boundary line, TIE_LINE): its tie line (none
// when unpaired). Its pairing key: BL_PAIRING_KEY; its characteristics: the LINE_* getters;
// invoke(tie line, ACT_CONNECT / ACT_DISCONNECT): connectBoundaryLines / disconnectBoundaryLines.
IIDM_CODE(BOUNDARY_LINE1_ID,           1030) // string, a field of the tie line adder: setBoundaryLine1
IIDM_CODE(BOUNDARY_LINE2_ID,           1031) // string, a field of the tie line adder: setBoundaryLine2

// ── Areas ────────────────────────────────────────────────────────────────────
// An area groups voltage levels: getChildren(area, VOLTAGE_LEVEL) (sorted by id), getChildren(vl,
// AREA), getRelatedByString(vl, AREA, area type) its area of a type (none without one);
// setRelated(area, ADD_VOLTAGE_LEVEL / REMOVE_VOLTAGE_LEVEL, vl) and setRelated(vl, ADD_AREA /
// REMOVE_AREA, area) add or remove one. Its boundaries: getChildren(area, AREA_BOUNDARY);
// invoke(area, AREA_BOUNDARY) starts a new one (setRelated fields REL_TERMINAL or BOUNDARY, and
// AREA_BOUNDARY_AC; ACT_ADD returns the area); setRelated(area, REMOVE_AREA_BOUNDARY, terminal or
// boundary) removes one. On a boundary: getRelated(boundary, AREA) its area, getRelated(boundary,
// REL_TERMINAL / BOUNDARY) what it is (none for the other). The area adder (invoke(network, AREA)):
// AREA_TYPE, AREA_INTERCHANGE_TARGET, setRelated(adder, ADD_VOLTAGE_LEVEL, vl), and invoke(adder,
// AREA_BOUNDARY) per boundary (nested: REL_TERMINAL or BOUNDARY, AREA_BOUNDARY_AC, ACT_ADD).
IIDM_CODE(AREA_TYPE,                   1040) // string (also an adder field); string list, on a network: its area types
IIDM_CODE(AREA_INTERCHANGE_TARGET,     1041) // double, optional (NaN: none; also an adder field)
IIDM_CODE(AREA_AC_INTERCHANGE,         1042) // double, read-only
IIDM_CODE(AREA_DC_INTERCHANGE,         1043) // double, read-only
IIDM_CODE(AREA_INTERCHANGE,            1044) // double, read-only
IIDM_CODE(AREA_BOUNDARY_AC,            1045) // bool, on an area boundary (also an adder field)
IIDM_CODE(AREA_BOUNDARY_P,             1046) // double, read-only, on an area boundary
IIDM_CODE(AREA_BOUNDARY_Q,             1047) // double, read-only, on an area boundary
IIDM_CODE(ADD_VOLTAGE_LEVEL,           1048) // set only (setRelated), on an area or its adder
IIDM_CODE(REMOVE_VOLTAGE_LEVEL,        1049) // set only, on an area
IIDM_CODE(ADD_AREA,                    1050) // set only, on a voltage level
IIDM_CODE(REMOVE_AREA,                 1051) // set only, on a voltage level
IIDM_CODE(REMOVE_AREA_BOUNDARY,        1052) // set only, on an area: the terminal or boundary of one of its boundaries

// ── VoltageAngleLimit ────────────────────────────────────────────────────────
// A limit of the voltage angle difference between two terminals (operational limits: LL_LIMIT_TYPE,
// properties, invoke(limit, ACT_REMOVE)): getChildren(network, VOLTAGE_ANGLE_LIMIT), findById(<it>,
// id); getRelated(limit, REL_TERMINAL_FROM / REL_TERMINAL_TO) its terminals. Its adder: invoke(network,
// VOLTAGE_ANGLE_LIMIT), fields VAL_ID, REL_TERMINAL_FROM and REL_TERMINAL_TO (setRelated),
// VAL_LOW_LIMIT, VAL_HIGH_LIMIT, properties.
IIDM_CODE(VAL_ID,                      1055) // string (also an adder field)
IIDM_CODE(VAL_LOW_LIMIT,               1056) // double, optional (none when unset; also an adder field)
IIDM_CODE(VAL_HIGH_LIMIT,              1057) // double, optional (none when unset; also an adder field)

// ── OverloadManagementSystem ─────────────────────────────────────────────────
// An automation system of a substation that operates elements when a monitored element is overloaded:
// getChildren(substation or network, OVERLOAD_MANAGEMENT_SYSTEM), findById(<it>, id),
// getRelated(system, REL_SUBSTATION) its substation, invoke(system, ACT_REMOVE). Its trippings, in
// order: getChildren(system, TRIPPING); setRelated(system, ADD_TRIPPING, tripping) adds one. Its adder:
// invoke(substation, OVERLOAD_MANAGEMENT_SYSTEM), fields AUTOMATION_SYSTEM_ENABLED,
// OMS_MONITORED_ELEMENT_ID, OMS_MONITORED_SIDE; invoke(adder, SWITCH_TRIPPING / BRANCH_TRIPPING /
// THREE_WINDINGS_TRANSFORMER_TRIPPING) starts a tripping (nested: the TRIPPING_* fields, properties).
IIDM_CODE(AUTOMATION_SYSTEM_ENABLED,   1060) // bool (also an adder field)
IIDM_CODE(OMS_MONITORED_ELEMENT_ID,    1061) // string, read-only (also an adder field)
IIDM_CODE(OMS_MONITORED_SIDE,          1062) // int, read-only: ThreeSides ordinal (also an adder field)
IIDM_CODE(ADD_TRIPPING,                1063) // set only (setRelated), on a system: addTripping
IIDM_CODE(TRIPPING_TYPE,               1064) // int, read-only: OverloadManagementSystem.Tripping.Type ordinal
IIDM_CODE(TRIPPING_KEY,                1065) // string, read-only (also an adder field)
IIDM_CODE(TRIPPING_NAME,               1066) // string: getNameOrKey; set: setName (also an adder field)
IIDM_CODE(TRIPPING_CURRENT_LIMIT,      1067) // double (also an adder field)
IIDM_CODE(TRIPPING_OPEN_ACTION,        1068) // bool (also an adder field)
IIDM_CODE(TRIPPING_ELEMENT_ID,         1069) // string: the switch, branch or 3WT to operate (also an adder field)
IIDM_CODE(TRIPPING_SIDE,               1070) // int: the side to operate, TwoSides (branch) or ThreeSides (3WT)
                                             // ordinal (also an adder field)

// ── Components ───────────────────────────────────────────────────────────────
// The connected and synchronous components of the bus view: getRelated(bus, REL_CONNECTED_COMPONENT /
// REL_SYNCHRONOUS_COMPONENT) the one of a bus (none when it is in none), getChildren(network,
// REL_CONNECTED_COMPONENT / REL_SYNCHRONOUS_COMPONENT) all of them; getChildren(component, BUS) its buses.
IIDM_CODE(COMPONENT_NUM,               1080) // int, read-only: 0 for the main component
IIDM_CODE(COMPONENT_SIZE,              1081) // int, read-only: its number of buses

// ── VariantManager ───────────────────────────────────────────────────────────
// invoke(manager, VARIANT_CLONE) starts cloneVariant: fields VARIANT_SOURCE_ID, VARIANT_TARGET_ID (each
// value set adds a target) and VARIANT_MAY_OVERWRITE (false when unset); ACT_ADD clones.
IIDM_CODE(VARIANT_IDS,                 1085) // string list (sorted)
IIDM_CODE(WORKING_VARIANT_ID,          1086) // string; set: setWorkingVariant
IIDM_CODE(REMOVE_VARIANT,              1087) // string, set only: removeVariant
IIDM_CODE(VARIANT_MULTI_THREAD_ACCESS, 1088) // bool: isVariantMultiThreadAccessAllowed; set: allowVariantMultiThreadAccess
IIDM_CODE(VARIANT_CLONE,               1089)
IIDM_CODE(VARIANT_SOURCE_ID,           1090) // string, a field of VARIANT_CLONE
IIDM_CODE(VARIANT_TARGET_ID,           1091) // string, a field of VARIANT_CLONE: one more target
IIDM_CODE(VARIANT_MAY_OVERWRITE,       1092) // bool, a field of VARIANT_CLONE

// ── ShuntCompensator ─────────────────────────────────────────────────────────
// Its model is getRelated(shunt, SHUNT_COMPENSATOR_MODEL); getRelated(shunt, SHUNT_COMPENSATOR_LINEAR_MODEL
// or SHUNT_COMPENSATOR_NON_LINEAR_MODEL) gives it as a model of that type (getModel(Class):
// ValidationException when it is of the other one). The sections of a non-linear model are
// getChildren(model, SHUNT_SECTION), from the first one. A new one: invoke(adder,
// SHUNT_COMPENSATOR_LINEAR_MODEL) starts its linear model (SHUNT_B_PER_SECTION, SHUNT_G_PER_SECTION and
// SHUNT_MAX_SECTION_COUNT fields), invoke(adder, SHUNT_COMPENSATOR_NON_LINEAR_MODEL) a non-linear one,
// then invoke(model, SHUNT_SECTION) each section (SHUNT_SECTION_B and SHUNT_SECTION_G); each ACT_ADD
// returns to the adder above.
IIDM_CODE(SHUNT_SECTION_COUNT,         1100) // int (optional: none when undefined); unset: ACT_UNSET_SECTION_COUNT
IIDM_CODE(SHUNT_MAX_SECTION_COUNT,     1101) // int: of the shunt; set: on its linear model (setMaximumSectionCount)
IIDM_CODE(SHUNT_B_PER_SECTION,         1102) // linear model
IIDM_CODE(SHUNT_G_PER_SECTION,         1103) // linear model
IIDM_CODE(SHUNT_MODEL_TYPE,            1104) // int, read-only: ShuntCompensatorModelType ordinal (0=LINEAR 1=NON_LINEAR)
IIDM_CODE(SHUNT_SECTION_B,             1105) // section of a non-linear model
IIDM_CODE(SHUNT_SECTION_G,             1106) // section of a non-linear model
IIDM_CODE(SHUNT_B,                     1110) // B at the section count; evaluate {sectionCount}: getB(sectionCount)
IIDM_CODE(SHUNT_SOLVED_SECTION_COUNT,  1111) // int (optional: none when unset); unset: ACT_UNSET_SOLVED_SECTION_COUNT
IIDM_CODE(SHUNT_G,                     1112) // G at the section count; evaluate {sectionCount}: getG(sectionCount)


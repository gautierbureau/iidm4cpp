IIDM_CODE(ACTIVE_POWER_CONTROL,       3000)
IIDM_CODE(EXT_APC_DROOP,              3001)
IIDM_CODE(EXT_APC_PARTICIPATE,        3002)
IIDM_CODE(EXT_APC_PARTICIPATION_FACTOR, 3003) // double
IIDM_CODE(EXT_APC_MIN_TARGET_P,       3004) // double, NaN = undefined (setting NaN unsets it)
IIDM_CODE(EXT_APC_MAX_TARGET_P,       3005) // double, NaN = undefined (setting NaN unsets it)

// CoordinatedReactiveControl (on a generator)
IIDM_CODE(COORDINATED_REACTIVE_CONTROL, 3100)
IIDM_CODE(EXT_CRC_Q_PERCENT,          3101) // double

// HvdcAngleDroopActivePowerControl (on an HVDC line)
IIDM_CODE(HVDC_ANGLE_DROOP_ACTIVE_POWER_CONTROL, 3200)
IIDM_CODE(EXT_HADAPC_DROOP,           3201) // double (a float in powsybl)
IIDM_CODE(EXT_HADAPC_P0,              3202) // double (a float in powsybl)
IIDM_CODE(EXT_HADAPC_ENABLED,         3203) // bool

// HvdcOperatorActivePowerRange (on an HVDC line)
IIDM_CODE(HVDC_OPERATOR_ACTIVE_POWER_RANGE, 3300)
IIDM_CODE(EXT_HOAR_OPR_CS1_TO_CS2,    3301) // double (a float in powsybl)
IIDM_CODE(EXT_HOAR_OPR_CS2_TO_CS1,    3302) // double (a float in powsybl)

// SlackTerminal (on a voltage level): getRelated / setRelated(extension, REL_TERMINAL) is its
// terminal for the current variant (also an adder field)
IIDM_CODE(SLACK_TERMINAL,             3500)
IIDM_CODE(EXT_ST_EMPTY,               3501) // bool, read-only: no terminal in any variant

// ── Limits ───────────────────────────────────────────────────────────────────
// A flows limits holder (FLOWS_LIMITS_HOLDER) is a 3WT leg, a boundary line, or one side of a
// branch: getRelatedByIndex(branch, FLOWS_LIMITS_HOLDER, side) (TwoSides ordinal). Its groups:
// getChildren(holder, OPERATIONAL_LIMITS_GROUP), getRelatedByString(holder, OPERATIONAL_LIMITS_GROUP,
// id) one of them, invoke(holder, OPERATIONAL_LIMITS_GROUP) a new one (adder field OLG_ID). The
// selected group: getRelated(holder, REL_SELECTED_OLG), getChildren(holder, REL_SELECTED_OLG) all of
// them, setRelated(holder, REL_SELECTED_OLG, INVALID_HANDLE) deselects them all, and
// invoke(holder, REL_SELECTED_OLG) starts getOrCreateSelectedOperationalLimitsGroup (field OLG_ID:
// that group). The limits of a type, CURRENT_LIMITS, ACTIVE_POWER_LIMITS or APPARENT_POWER_LIMITS:
// getRelated(holder, <type>) those of the selected group, getChildren(holder, <type>) those of every
// selected group, getRelatedByString(holder, <type>, id) those of group id; getRelated(group,
// <type>) those of a group, invoke(group, <type>) their adder, setRelated(group, <type>,
// INVALID_HANDLE) removes them. getRelatedByIndex(holder or group, LOADING_LIMITS, type): the limits
// of a LimitType. Limits: getChildren(limits, TEMPORARY_LIMIT) their temporary limits,
// getRelatedByIndex(limits, TEMPORARY_LIMIT, acceptableDuration) one of them, invoke(limits adder,
// TEMPORARY_LIMIT) the adder of a new one (beginTemporaryLimit).
IIDM_CODE(LL_PERMANENT_LIMIT,          1970) // double (also an adder field)
IIDM_CODE(TL_VALUE,                    1971) // double, on a temporary limit (and its adder)
IIDM_CODE(TL_ACCEPTABLE_DURATION,      1972) // int, on a temporary limit (and its adder)
IIDM_CODE(TL_FICTITIOUS,               1973) // bool, on a temporary limit (and its adder)
IIDM_CODE(TL_NAME,                     1974) // string, on a temporary limit (and its adder)
IIDM_CODE(LL_PERMANENT_LIMIT_NAME,     1975) // string (also an adder field)
IIDM_CODE(LL_DETECTION_KIND,           1976) // int: DetectionKind ordinal, read-only (also an adder field)
IIDM_CODE(LL_LIMIT_TYPE,               1977) // int: LimitType ordinal, read-only
IIDM_CODE(LL_TEMPORARY_LIMIT_VALUE,    1978) // evaluate(limits, <it>, {acceptableDuration}): its value;
                                             // invoke(limits, <it>): setTemporaryLimitValue (fields
                                             // TL_ACCEPTABLE_DURATION and TL_VALUE)
IIDM_CODE(OLG_ID,                      1980) // string: group identifier (also an adder field)
IIDM_CODE(OLG_EMPTY,                   1981) // bool: isEmpty()
IIDM_CODE(SELECTED_OLG_ID,             1982) // string, on a holder: the selected group id (none when
                                             // none is); set: setSelectedOperationalLimitsGroup
IIDM_CODE(ADD_SELECTED_OLG,            1983) // string, on a holder, set only: addSelectedOperationalLimitsGroups
IIDM_CODE(DESELECT_OLG,                1984) // string, on a holder, set only: deselectOperationalLimitsGroups
IIDM_CODE(REMOVE_OLG,                  1985) // string, on a holder, set only: removeOperationalLimitsGroup
IIDM_CODE(ALL_SELECTED_OLG_IDS,        1986) // string list, on a holder (sorted)
IIDM_CODE(ALL_SELECTED_OLG_IDS_ORDERED, 1987) // string list, on a holder (in selection order)

// ── Relations (used in getRelated) ──────────────────────────────────────────
IIDM_CODE(REL_TERMINAL1,               2000)
IIDM_CODE(REL_TERMINAL2,               2001)
IIDM_CODE(REL_TERMINAL,                2002) // injection or regulation → its terminal; branch or 3WT keyed by voltage level id (getRelatedByString)

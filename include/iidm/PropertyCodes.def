IIDM_CODE(REL_NBV_SWITCH,              2038) // VL: node-breaker view switches (getChildren), one (getRelatedByString)
IIDM_CODE(REL_PARENT_NETWORK,          2036) // identifiable → the smallest network that holds it
IIDM_CODE(REL_VL_BBV_BUS1,            2023) // VL (keyed by switchId) → Bus on side 1 (getRelatedByString)
IIDM_CODE(REL_VL_BBV_BUS2,            2024) // VL (keyed by switchId) → Bus on side 2 (getRelatedByString)

// ── VoltageRegulation (powsybl 7.4 core model) ───────────────────────────────
// VOLTAGE_REGULATION is the type code: getRelated(holder, VOLTAGE_REGULATION) gives the
// holder's regulation (INVALID_HANDLE when it has none), on which the VR_* codes apply;
// invoke(holder or holder adder, VOLTAGE_REGULATION) starts a new one; setRelated(holder,
// VOLTAGE_REGULATION, INVALID_HANDLE) removes it.
IIDM_CODE(VOLTAGE_REGULATION,          2200)
IIDM_CODE(VR_TARGET_VALUE,             2201) // double (reactive power: load sign convention)
IIDM_CODE(VR_TARGET_DEADBAND,          2202) // double
IIDM_CODE(VR_SLOPE,                    2203) // double
IIDM_CODE(VR_MODE,                     2204) // int: RegulationMode ordinal, -1 = none
IIDM_CODE(VR_REGULATING,               2205) // bool
IIDM_CODE(VR_WITH_TERMINAL,            2206) // bool: a regulated terminal is set (getRelated(regulation, REL_TERMINAL))
// The terminal and target value change together: invoke(regulation, REL_TERMINAL), set REL_TERMINAL
// (setRelated, INVALID_HANDLE for local regulation) and VR_TARGET_VALUE, then invoke(change, ACT_ADD).
// Methods of every regulation holder
IIDM_CODE(LOCAL_TARGET_V,              2210) // double
IIDM_CODE(LOCAL_TARGET_Q,              2211) // double
IIDM_CODE(REGULATING,                  2212) // bool: has a regulation, and it is regulating (a tap changer: isRegulating);
                                            // set: PhaseTapChanger.setRegulating (the others regulate through their VoltageRegulation)
IIDM_CODE(REGULATING_TARGET_V,         2213) // double, read-only: regulation target if it regulates V remotely, else local target V
IIDM_CODE(REGULATING_TARGET_Q,         2214) // double, read-only: same for Q
IIDM_CODE(REGULATING_MODES,            2215) // int list: the modes m for which isRegulatingWithMode(m)
IIDM_CODE(WITH_MODES,                  2216) // int list: the modes m for which isWithMode(m)
IIDM_CODE(HAS_REGULATING_TERMINAL,     2217) // bool: the regulation has a terminal
// Holders: Generator, Battery, StaticVarCompensator, ShuntCompensator, VscConverterStation,
// RatioTapChanger; the regulating terminal is REL_REGULATING_TERMINAL; actions ACT_SET_TARGET_Q_TO_Q,
// ACT_SET_TARGET_V_TO_V

// ── Actions (invoke) ─────────────────────────────────────────────────────────
// invoke(parent, <type code>) starts a new object: it returns an adder, on which the setters
// take the object's own property codes (setDouble(adder, GEN_TARGET_P, 100)); nothing changes
// in the network until invoke(adder, ACT_ADD).
IIDM_CODE(ACT_ADD,                     5000) // invoke(adder): adds the object, returns it (INVALID_HANDLE for nested adders)
// A copy: setRelated(adder, COPY_OF, copied), before any field, restarts the adder of a new line, two
// windings transformer, tap changer, reactive capability curve or loading limits from the copied object
// (powsybl newX(copied): a line or a transformer also gets the operational limits of the copied one on
// add()); setRelated(adder, FILL_FROM, copied) fills the adder of a line or of a two windings
// transformer with its values (LineAdder.fillLineAdder, TwoWindingsTransformerAdder.fillTwoWindingsTransformerAdder).
IIDM_CODE(COPY_OF,                     5090) // related, set only, on an adder
IIDM_CODE(FILL_FROM,                   5091) // related, set only, on an adder
IIDM_CODE(ACT_REMOVE,                  5001) // invoke(identifiable): removes it from the network; invoke(tap changer): removes it
// invoke(terminal or connectable, ACT_CONNECT / ACT_DISCONNECT): connects / disconnects it (every
// terminal of a connectable, the converter stations of an HVDC line); returns the object when this
// changed it, INVALID_HANDLE when it could not, or already was.
IIDM_CODE(ACT_CONNECT,                 5002)
IIDM_CODE(ACT_DISCONNECT,              5003)
// invoke(terminal or connectable, CONNECT / DISCONNECT) starts connecting / disconnecting it through
// the switches that a predicate accepts (powsybl connect(Predicate<Switch>, side)): field
// SWITCH_PREDICATE, and TERMINAL_SIDE for one side of a connectable (ThreeSides ordinal; TwoSides
// for an HVDC line or a tie line), every side when unset; then invoke(call, ACT_ADD) returns the
// object when this changed it, INVALID_HANDLE when it could not, or already was.
IIDM_CODE(CONNECT,                     5027)
IIDM_CODE(DISCONNECT,                  5028)
IIDM_CODE(SWITCH_PREDICATE,            5029) // int, a field of CONNECT and DISCONNECT: SwitchPredicate ordinal
IIDM_CODE(ACT_SET_TARGET_Q_TO_Q,       5004) // invoke(regulation holder): targets Q from the solved Q;
                                             // invoke(boundary line): its generation's; invoke(load): Q0
IIDM_CODE(ACT_SET_TARGET_V_TO_V,       5005) // invoke(regulation holder): targets V from the solved V;
                                             // invoke(boundary line): its generation's
IIDM_CODE(ACT_UNSET_TAP_POSITION,      5006) // invoke(tap changer)
IIDM_CODE(ACT_UNSET_SOLVED_TAP_POSITION, 5007) // invoke(tap changer)
IIDM_CODE(ACT_APPLY_SOLVED_VALUES,     5008) // invoke(tap changer, transformer, generator, battery, load, shunt
                                             // compensator, boundary line): its solved values become its values
IIDM_CODE(ACT_SET_TAP_POSITION_TO_SOLVED_TAP_POSITION, 5009) // invoke(tap changer)
IIDM_CODE(ACT_CLEAN_IF_EMPTY,          5010) // invoke(extension): removes it when empty (Measurements,
                                             // DiscreteMeasurements, SlackTerminal)
IIDM_CODE(ACT_UNSET_SECTION_COUNT,     5011) // invoke(shunt compensator)
IIDM_CODE(ACT_UNSET_SOLVED_SECTION_COUNT, 5012) // invoke(shunt compensator)
IIDM_CODE(ACT_SET_SECTION_COUNT_TO_SOLVED_SECTION_COUNT, 5013) // invoke(shunt compensator)
IIDM_CODE(ACT_UNSET_SOLVED_VALUES,     5014) // invoke(connectable, terminal, bus): unsets its solved values (flows,
                                             // voltages; a shunt's solved section count, a transformer's tap positions)
IIDM_CODE(ACT_SET_RATIO_TAP_POSITION_TO_SOLVED_TAP_POSITION, 5015) // invoke(2WT or 3WT): of its ratio tap changers
IIDM_CODE(ACT_SET_PHASE_TAP_POSITION_TO_SOLVED_TAP_POSITION, 5016) // invoke(2WT or 3WT): of its phase tap changers
IIDM_CODE(ACT_SET_TARGET_P_TO_P,       5017) // invoke(generator, battery): targets P from the solved P;
                                             // invoke(boundary line): its generation's; invoke(load): P0
IIDM_CODE(ACT_REMOVE_ALL_BUSES,        5018) // invoke(voltage level): those of its bus-breaker view
IIDM_CODE(ACT_REMOVE_ALL_SWITCHES,     5019) // invoke(voltage level): those of its bus-breaker view
IIDM_CODE(ACT_REMOVE_UPDATING_BOUNDARY_LINES, 5020) // invoke(tie line): remove(true), its boundary lines taking
                                             // the flows at the boundary as P0 and Q0
IIDM_CODE(ACT_DETACH,                  5021) // invoke(subnetwork): detach, returns the new network
IIDM_CODE(ACT_FLATTEN,                 5022) // invoke(network): flatten, its subnetworks merged into it
IIDM_CODE(ACT_REMOVE_ORDER,            5023) // invoke(feeder of a ConnectablePosition): removeOrder
IIDM_CODE(ACT_DELETE_REFERENCE_PRIORITIES, 5024) // invoke(ReferencePriorities or network): see ReferencePriorities
IIDM_CODE(ACT_RESET_REFERENCE_TERMINALS, 5025) // invoke(ReferenceTerminals or network): see ReferenceTerminals
IIDM_CODE(ACT_ADD_REFERENCE_TERMINAL,  5026) // invoke(terminal): ReferenceTerminals.addTerminal


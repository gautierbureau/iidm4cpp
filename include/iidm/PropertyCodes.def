IIDM_CODE(REL_REGULATING_TERMINAL,     2008) // regulation holder → terminal of a remote regulation, else its own
IIDM_CODE(REL_SELECTED_OLG,            2014) // flows limits holder → its selected group (see Limits)
IIDM_CODE(REL_HVDC_LINE,               2016) // converter station → its HvdcLine (none when not in an HVDC line)
IIDM_CODE(REL_CURRENT_STEP,            2017) // tap changer → step at its tap position (none when unset)
IIDM_CODE(REL_SOLVED_CURRENT_STEP,     2018) // tap changer → step at its solved tap position (none when unset)
IIDM_CODE(REL_NEUTRAL_STEP,            2019) // tap changer → its neutral step (none without one)
IIDM_CODE(REL_REGULATION_TERMINAL,     2020) // phase tap changer → regulation terminal (none); set: setRelated
IIDM_CODE(REL_NBV_TERMINAL_AT_NODE,    2021) // NodeBreakerView: terminal at node (use getRelatedByIndex)
IIDM_CODE(REL_CONNECTABLE,             2022) // Terminal → its Connectable
IIDM_CODE(REL_CONVERTER_STATION1,      2030) // HvdcLine → converter station 1
IIDM_CODE(REL_CONVERTER_STATION2,      2031) // HvdcLine → converter station 2
IIDM_CODE(REL_OTHER_CONVERTER_STATION, 2032) // converter station → the other station of its HVDC line (none without line)
IIDM_CODE(REL_BBV_BUS,                 2033) // VL or network (keyed by bus id) → bus-breaker view bus (getRelatedByString)
IIDM_CODE(REL_BV_BUS,                  2034) // VL or network: bus view buses (getChildren), one (getRelatedByString);
                                            // terminal → its bus view bus (none when disconnected)
IIDM_CODE(REL_BV_CONNECTABLE_BUS,      2039) // terminal → its bus view connectable bus (none without one)
IIDM_CODE(REL_BBV_BUSES_OF_BV_BUS,     2040) // VL (keyed by bus view bus id) → list of bus-breaker view buses
IIDM_CODE(REL_MERGED_BUS,              2035) // VL (keyed by configured bus or busbar section id) → bus view bus
IIDM_CODE(REL_BBV_SWITCH,              2037) // VL or network: bus-breaker view switches (getChildren), one (getRelatedByString)
IIDM_CODE(REL_NBV_SWITCH,              2038) // VL: node-breaker view switches (getChildren), one (getRelatedByString)
IIDM_CODE(REL_PARENT_NETWORK,          2036) // identifiable → the smallest network that holds it
IIDM_CODE(REL_VL_BBV_BUS1,            2023) // VL (keyed by switchId) → Bus on side 1 (getRelatedByString)
IIDM_CODE(REL_VL_BBV_BUS2,            2024) // VL (keyed by switchId) → Bus on side 2 (getRelatedByString)

// ── VoltageRegulation (powsybl 7.4 core model) ───────────────────────────────
// VOLTAGE_REGULATION is the type code: getRelated(holder, VOLTAGE_REGULATION) gives the
// holder's regulation (INVALID_HANDLE when it has none), on which the VR_* codes apply;
// invoke(holder or holder adder, VOLTAGE_REGULATION) starts a new one; setRelated(holder,

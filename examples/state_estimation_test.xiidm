<?xml version="1.0" encoding="UTF-8"?>
<!--
    Minimal test network carrying every state estimation extension supported by iidm4cpp:
    measurements, discreteMeasurements, injectionObservability, branchObservability,
    twoWindingsTransformerToBeEstimated, threeWindingsTransformerToBeEstimated and
    observabilityArea (bus-breaker VL1, node-breaker VL4).
    Generated from StateEstimationDispatchTest.createNetwork() (powsybl-core 7.4.0, IIDM 1.18).
-->
<iidm:network xmlns:iidm="http://www.powsybl.org/schema/iidm/1_18" xmlns:io="http://www.itesla_project.eu/schema/iidm/ext/injection_observability/1_0" xmlns:m="http://www.powsybl.org/schema/iidm/ext/measurements/1_0" xmlns:dm="http://www.powsybl.org/schema/iidm/ext/discrete_measurements/1_0" xmlns:bo="http://www.itesla_project.eu/schema/iidm/ext/branch_observability/1_0" xmlns:oa="http://www.powsybl.org/schema/iidm/ext/observability_area/1_0" xmlns:twottbe="http://www.powsybl.org/schema/iidm/ext/two_windings_transformer_to_be_estimated/1_0" xmlns:threettbe="http://www.powsybl.org/schema/iidm/ext/three_windings_transformer_to_be_estimated/1_0" id="state_estimation_test" caseDate="2026-01-01T00:00:00.000Z" forecastDistance="0" sourceFormat="test" minimumValidationLevel="STEADY_STATE_HYPOTHESIS">
    <iidm:substation id="S1" country="FR">
        <iidm:voltageLevel id="VL1" nominalV="400.0" topologyKind="BUS_BREAKER">
            <iidm:busBreakerTopology>
                <iidm:bus id="B1"/>
                <iidm:bus id="B2"/>
                <iidm:switch id="SW1" kind="BREAKER" retained="true" open="false" bus1="B1" bus2="B2"/>
            </iidm:busBreakerTopology>
            <iidm:generator id="G1" energySource="OTHER" minP="0.0" maxP="500.0" targetP="100.0" localTargetV="400.0" bus="B1" connectableBus="B1">
                <iidm:minMaxReactiveLimits minQ="-1.7976931348623157E308" maxQ="1.7976931348623157E308"/>
                <iidm:voltageRegulation mode="VOLTAGE" regulating="true"/>
            </iidm:generator>
        </iidm:voltageLevel>
        <iidm:voltageLevel id="VL2" nominalV="225.0" topologyKind="BUS_BREAKER">
            <iidm:busBreakerTopology>
                <iidm:bus id="B3"/>
            </iidm:busBreakerTopology>
            <iidm:load id="L2" loadType="UNDEFINED" p0="80.0" q0="10.0" bus="B3" connectableBus="B3"/>
        </iidm:voltageLevel>
        <iidm:voltageLevel id="VL3" nominalV="63.0" topologyKind="BUS_BREAKER">
            <iidm:busBreakerTopology>
                <iidm:bus id="B4"/>
            </iidm:busBreakerTopology>
        </iidm:voltageLevel>
        <iidm:twoWindingsTransformer id="T2" r="0.5" x="10.0" ratedU1="400.0" ratedU2="225.0" voltageLevelId1="VL1" bus1="B1" connectableBus1="B1" voltageLevelId2="VL2" bus2="B3" connectableBus2="B3">
            <iidm:ratioTapChanger tapPosition="3" loadTapChangingCapabilities="false">
                <iidm:step rho="0.95"/>
                <iidm:step rho="0.97"/>
                <iidm:step rho="0.99"/>
                <iidm:step rho="1.01"/>
            </iidm:ratioTapChanger>
        </iidm:twoWindingsTransformer>
        <iidm:threeWindingsTransformer id="T3" r1="0.1" x1="5.0" ratedU1="400.0" r2="0.1" x2="5.0" ratedU2="225.0" r3="0.1" x3="5.0" ratedU3="63.0" ratedU0="400.0" voltageLevelId1="VL1" bus1="B2" connectableBus1="B2" voltageLevelId2="VL2" bus2="B3" connectableBus2="B3" voltageLevelId3="VL3" bus3="B4" connectableBus3="B4"/>
    </iidm:substation>
    <iidm:substation id="S2" country="FR">
        <iidm:voltageLevel id="VL4" nominalV="400.0" topologyKind="NODE_BREAKER">
            <iidm:nodeBreakerTopology>
                <iidm:busbarSection id="BBS1" node="0"/>
                <iidm:switch id="BR1" kind="BREAKER" open="false" node1="0" node2="1"/>
                <iidm:switch id="BR2" kind="BREAKER" open="false" node1="0" node2="2"/>
            </iidm:nodeBreakerTopology>
            <iidm:load id="L4" loadType="UNDEFINED" p0="20.0" q0="5.0" node="1"/>
        </iidm:voltageLevel>
    </iidm:substation>
    <iidm:line id="LINE1" r="1.0" x="20.0" voltageLevelId1="VL1" bus1="B1" connectableBus1="B1" voltageLevelId2="VL4" node2="2"/>
    <iidm:extension id="BBS1">
        <io:injectionObservability>
            <io:qualityV standardDeviation="0.8" redundant="false"/>
        </io:injectionObservability>
        <m:measurements>
            <m:measurement id="BBS1_V" type="VOLTAGE" value="401.0" standardDeviation="2.0" valid="true"/>
        </m:measurements>
    </iidm:extension>
    <iidm:extension id="G1">
        <io:injectionObservability observable="true">
            <io:qualityP standardDeviation="1.5" redundant="true"/>
            <io:qualityQ standardDeviation="2.0"/>
        </io:injectionObservability>
        <m:measurements>
            <m:measurement id="G1_P" type="ACTIVE_POWER" value="101.5" standardDeviation="1.0" valid="true"/>
            <m:measurement id="G1_Q" type="REACTIVE_POWER" value="12.0" standardDeviation="0.5" valid="false"/>
        </m:measurements>
    </iidm:extension>
    <iidm:extension id="SW1">
        <dm:discreteMeasurements>
            <dm:discreteMeasurement id="SW1_POS" type="SWITCH_POSITION" valueType="BOOLEAN" value="true" valid="true"/>
            <dm:discreteMeasurement id="SW1_STATE" type="OTHER" valueType="STRING" value="CLOSED" valid="false"/>
        </dm:discreteMeasurements>
    </iidm:extension>
    <iidm:extension id="LINE1">
        <bo:branchObservability observable="true">
            <bo:qualityP side="ONE" standardDeviation="0.1" redundant="false"/>
            <bo:qualityQ side="TWO" standardDeviation="0.2"/>
        </bo:branchObservability>
        <m:measurements>
            <m:measurement id="LINE1_P1" type="ACTIVE_POWER" side="ONE" value="55.0" standardDeviation="0.3" valid="true"/>
            <m:measurement id="LINE1_I2" type="CURRENT" side="TWO" value="80.0" standardDeviation="2.0" valid="true"/>
        </m:measurements>
    </iidm:extension>
    <iidm:extension id="VL1">
        <oa:observabilityArea consistentWithTopology="false">
            <oa:bus areaNumber="1" status="OBSERVABLE" ids="B1"/>
            <oa:bus areaNumber="2" status="BORDER" ids="B2"/>
        </oa:observabilityArea>
    </iidm:extension>
    <iidm:extension id="T2">
        <twottbe:twoWindingsTransformerToBeEstimated ratioTapChangerStatus="true" phaseTapChangerStatus="false"/>
        <dm:discreteMeasurements>
            <dm:discreteMeasurement id="T2_TAP" type="TAP_POSITION" tapChanger="RATIO_TAP_CHANGER" valueType="INT" value="3" valid="true"/>
        </dm:discreteMeasurements>
    </iidm:extension>
    <iidm:extension id="T3">
        <threettbe:threeWindingsTransformerToBeEstimated ratioTapChanger1Status="true" ratioTapChanger2Status="false" ratioTapChanger3Status="false" phaseTapChanger1Status="false" phaseTapChanger2Status="false" phaseTapChanger3Status="true"/>
    </iidm:extension>
    <iidm:extension id="VL4">
        <oa:observabilityArea consistentWithTopology="true">
            <oa:bus areaNumber="7" status="NON_OBSERVABLE" nodes="0,1,2"/>
        </oa:observabilityArea>
    </iidm:extension>
</iidm:network>
